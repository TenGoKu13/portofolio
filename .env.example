# === Discord OAuth2 ===
# Crée une application sur https://discord.com/developers/applications
# Onglet "OAuth2" -> Client ID / Client Secret
# Ajoute l'URL de redirection : https://tengoku.ch/api/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# URL publique du site (sans slash final)
# En local : http://localhost:3000
# En prod  : https://tengoku.ch
NEXT_PUBLIC_BASE_URL=https://tengoku.ch

# Ton ID Discord (celui qui a accès au tableau de bord admin)
ADMIN_DISCORD_ID=806590748791144448

# Secret pour signer les sessions (génère une longue chaîne aléatoire)
# ex: openssl rand -hex 32
SESSION_SECRET=change-moi-en-quelque-chose-de-long-et-aleatoire
